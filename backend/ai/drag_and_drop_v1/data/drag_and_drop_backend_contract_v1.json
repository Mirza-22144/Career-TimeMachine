{
  "activity_type": "drag_and_drop",
  "backend_request_fields": [
    "role_id",
    "skills",
    "years_experience",
    "responsibilities",
    "difficulty",
    "activity_type"
  ],
  "ai_response_fields": [
    "title",
    "situation",
    "sentence_template",
    "blanks",
    "options",
    "feedback_by_option",
